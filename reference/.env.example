# yieldRotate reference agent — environment configuration
#
# Copy this file to .env and fill in the values for your deployment.
# All addresses are on Base (chainId 8453).

# SMA (Safe wallet) address that holds the USDC and deploys into venues
SMA_ADDRESS=

# USDC token address on Base (6 decimals)
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Aave V3 Pool address on Base (supply/withdraw are called on this contract)
AAVE_POOL_ADDRESS=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5

# Aave aToken address on Base (the interest-bearing position token, already 6-dec)
AAVE_A_TOKEN_ADDRESS=0x4e65fE4DBa92790696D040AC24Aa414708F5c0Ab

# Morpho ERC-4626 vault address on Base
MORPHO_VAULT_ADDRESS=0xbeeF010f9cb27031ad51e3333f9aF9C6B1228183

# Euler ERC-4626 / EVC vault address on Base
EULER_VAULT_ADDRESS=0x07954BEB7e137101A7cbb3e47864C684aEC50524

# Base RPC endpoint URL (read-only — no transactions are sent by the agent or test)
BASE_RPC_URL=

# Cambrian API key for fetching supply APY data
CAMBRIAN_API_KEY=

# Cambrian API endpoints (one per venue)
CAMBRIAN_AAVE_URL=
CAMBRIAN_MORPHO_URL=
CAMBRIAN_EULER_URL=
